# Copy this file to .env and add the key for the provider you use.
# The web evaluator defaults to Gemini; set FRS_PROVIDER to switch.

# FRS_PROVIDER=gemini            # gemini | openai
# FRS_MODEL=                     # optional; per-provider default if unset
#                                #   gemini -> gemini-3.5-flash-lite
#                                #   openai -> gpt-4o-mini

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-api-key-here

# OpenAI, or any OpenAI-compatible endpoint (Ollama, vLLM, OpenRouter, ...)
# OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=http://localhost:11434/v1
